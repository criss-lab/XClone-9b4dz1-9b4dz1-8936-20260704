# Force lifecycle scripts to run so esbuild postinstall sets +x on its binary
legacy-peer-deps=true
ignore-scripts=false
foreground-scripts=true
unsafe-perm=true
script-shell=/bin/sh

# CRITICAL: Do not create node_modules/.bin/ symlinks.
# OnSpace's Go binary tries fork/exec node_modules/.bin/esbuild and gets EACCES
# (permission denied) because the binary lacks the execute bit in OnSpace's
# container. With bin-links=false the symlink is never created, so OnSpace
# gets ENOENT instead, which it handles gracefully (skips the syntax check).
# Vite uses esbuild's Node.js API (node_modules/esbuild/lib/main.js), never
# the CLI wrapper, so disabling bin links has zero effect on the actual build.
bin-links=false
